internal:
  devices:
{% if pe_role == 'tpe' %}
    - enp2s0
    - enp3s0
{% else %}
    - enp2s0
    - enp3s0
{% endif %}
  bpf:
    device_mode: {{ vinbero_device_mode | default('driver') }}
    verifier_log_level: 1
    verifier_log_size: 16777216
  server:
    bind: 127.0.0.1:8080
  logger:
    level: info
    format: text
    no_color: true

settings:
  enable_stats: true
  pin_maps:
    enabled: false
  entries:
    sid_function: {capacity: 1024}
    headendv4: {capacity: 4096}
    headendv6: {capacity: 1024}

vrfs:
  entries:
{% if pe_role == 'tpe' %}
    - name: mup-access
      acs:
        - {interface: enp2s0}
{% else %}
    - name: mup-dn
      table_id: 100
      members: [enp3s0]
      enable_l3mdev_rule: true
      acs:
        - {interface: enp3s0}
{% endif %}

bgp:
  global:
    local_asn: {{ lab_config.mup.local_asn }}
    router_id: "{{ ansible_host }}"
    listen_port: 179
    source_locator: LOC1
{% if pe_role == 'tpe' %}
    next_hop: "{{ lab_config.networks.sr_underlay.tpe_ipv6 }}"
{% else %}
    next_hop: "{{ lab_config.networks.sr_underlay.npe_ipv6 }}"
{% endif %}
    mup_max_routes: 4096
  locators:
{% if pe_role == 'tpe' %}
    - name: LOC1
      prefix: {{ lab_config.networks.sr_underlay.tpe_locator }}
      block_len: 32
      node_len: 16
      function_len: 16
      argument_len: 64
{% else %}
    - name: LOC1
      prefix: {{ lab_config.networks.sr_underlay.npe_locator }}
      block_len: 32
      node_len: 16
      function_len: 16
      argument_len: 64
{% endif %}
  vrf_bindings:
{% if pe_role == 'tpe' %}
    - vrf_name: mup-access
      rd: "{{ lab_config.mup.session_rd }}"
      families:
        mup_ipv4:
          route_targets:
            - {rt: "{{ lab_config.mup.t2_route_target }}", direction: import}
{% else %}
    - vrf_name: mup-dn
      rd: "{{ lab_config.mup.session_rd }}"
      mup_gtp4_source_prefix: {{ lab_config.networks.sr_underlay.npe_gtp4_source_prefix }}
      families:
        mup_ipv4:
          route_targets:
            - {rt: "{{ lab_config.mup.t1_route_target }}", direction: import}
            - {rt: "{{ lab_config.mup.t2_route_target }}", direction: import}
{% endif %}
  peers:
    - neighbor: {{ lab_config.nodes.mupc.management_ipv4 }}
      peer_asn: {{ lab_config.mup.local_asn }}
      hold_time_sec: 15
      keepalive_sec: 5
      connect_retry_sec: 3
      passive: true
      families: [mup_ipv4]
