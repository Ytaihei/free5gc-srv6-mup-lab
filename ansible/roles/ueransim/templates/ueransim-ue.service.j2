[Unit]
Description=UERANSIM UE
After=network-online.target ueransim-gnb.service
Requires=ueransim-gnb.service

[Service]
Type=simple
WorkingDirectory=/opt/UERANSIM
ExecStartPre=/bin/sleep 3
ExecStart=/opt/UERANSIM/build/nr-ue -c /opt/UERANSIM/config/free5gc-ue.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
